<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.android.systemui.volumetile">
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <application android:allowBackup="false" android:directBootAware="true" android:icon="@drawable/ic_volume_tile" android:label="@string/app_name">
        <service android:exported="true" android:icon="@drawable/ic_volume_tile" android:label="@string/tile_label" android:name="com.android.systemui.volumetile.VolumeTileService" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true"/>
        </service>

        <activity android:name="com.android.systemui.volumetile.VolumeSettingsActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES"/>
            </intent-filter>
        </activity>
    </application>
</manifest>